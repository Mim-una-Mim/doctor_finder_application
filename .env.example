# Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit your real .env file to Git.

# ── Server ──────────────────────────────────────────────
PORT=5000

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=doctor_finder
DB_PORT=3306

# Set to "true" when connecting to a cloud MySQL provider that requires SSL
# Leave empty or unset for local development
DB_SSL=

# ── Authentication ────────────────────────────────────────
# Use a long, random string in production (e.g., openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key

# ── CORS (cloud deployment only) ─────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty to allow all origins (fine for local dev).
# Example: https://your-app.netlify.app,https://your-electron-app.com
ALLOWED_ORIGINS=

# ── Password Reset Email URL ──────────────────────────────
# Full URL of your deployed frontend (used in password-reset emails).
# Leave empty for local development (defaults to http://localhost:PORT).
APP_BASE_URL=

# ── SMTP (optional — for password reset emails) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
